---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="rail foot__inner">
    <p class="label">© {year} {site.name}</p>
    <p class="label">
      {site.location} ·
      <span class="tabular" data-clock={site.timezone}>--:--</span> local
    </p>
    <p class="label foot__built">Astro · GSAP · hand-written CSS</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--paper);
    color: var(--ink);
    border-top: 1px solid var(--line);
    padding-block: var(--sp-5);
    transition: background-color var(--dur-mid) ease, color var(--dur-mid) ease;
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    justify-content: space-between;
    align-items: center;
  }

  .foot__built { margin-inline-start: auto; }
</style>
