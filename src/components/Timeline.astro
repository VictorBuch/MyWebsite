---
interface Entry {
  company: string;
  role: string;
  from: string;
  to: string;
  blurb: string;
  placeholder: boolean;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<section class="section track" id="experience" data-ground="paper" data-track tabindex="-1">
  <div class="track__frame">
    <header class="rail sec-head" data-reveal-group>
      <p class="label" data-reveal>Experience</p>
      <h2 class="track__title" data-reveal>Where the hours went</h2>
    </header>

    <ol class="track__lane" data-track-lane role="list">
      {
        entries.map((entry) => (
          <li class="stop">
            <p class="stop__dates label">
              {entry.from} — {entry.to}
              {entry.placeholder && <span class="stop__todo"> · dates to confirm</span>}
            </p>
            <h3 class="stop__company">{entry.company}</h3>
            <p class="stop__role">{entry.role}</p>
            <p class="stop__blurb">{entry.blurb}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Below 900px this is an ordinary vertical list. The pinned horizontal
     scroll is added by the Track motion only when the viewport can hold it
     and the viewer has not asked for reduced motion. */
  .track { overflow: hidden; }

  .track__title {
    font-size: var(--step-3);
    font-variation-settings: "wght" 700, "wdth" 88;
  }

  .track__lane {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    width: var(--rail);
    margin-inline: auto;
    border-top: 1px solid var(--line);
  }

  .stop {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }

  .stop__dates { color: var(--poppy-ink); }
  .stop__todo { color: var(--ink-soft); }

  .stop__company {
    font-size: var(--step-2);
    font-variation-settings: "wght" 700, "wdth" 86;
  }

  .stop__role {
    font-family: var(--f-util);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .stop__blurb {
    max-width: 46ch;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }

  /* Still-page fallback for the timeline: two columns instead of one long list. */
  @media (min-width: 760px) {
    .track:not([data-track-active='true']) .track__lane {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      gap: 0 var(--sp-5);
    }
  }

  /* The horizontal lane exists only while the Track motion is driving it.
     Without that (JS off, reduced motion, narrow viewport) the list stays
     vertical rather than overflowing off-screen with no way to scroll it. */
  @media (min-width: 900px) {
    .track[data-track-active='true'] { min-height: 100svh; display: grid; align-content: center; }

    .track[data-track-active='true'] .track__lane {
      flex-direction: row;
      align-items: stretch;
      gap: var(--sp-4);
      width: max-content;
      padding-inline: var(--gutter);
      margin-inline: 0;
      border-top: 0;
      will-change: transform;
    }

    .track[data-track-active='true'] .stop {
      flex: 0 0 min(78vw, 380px);
      border-bottom: 0;
      border-left: 2px solid var(--line);
      padding: var(--sp-3) var(--sp-3) var(--sp-4);
      background: var(--paper-2);
      border-radius: 0 4px 4px 0;
    }

    .track[data-track-active='true'] .stop:first-child { border-left-color: var(--poppy); }
  }
</style>
